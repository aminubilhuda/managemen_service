{
  "expo": {
    "name": "Wahyu Teknik Indotama",
    "slug": "wahyu-teknik-indotama",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Aplikasi membutuhkan izin kamera untuk memindai barcode nomor tiket dan mengambil foto fisik unit servis.",
        "NSPhotoLibraryUsageDescription": "Aplikasi membutuhkan izin galeri untuk memilih foto dokumentasi unit servis."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.wahyuteknikindotama"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Aplikasi membutuhkan izin kamera untuk memindai barcode nomor tiket dan mengambil foto fisik unit servis."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Aplikasi membutuhkan izin galeri untuk memilih foto dokumentasi servis."
        }
      ]
    ]
  }
}
